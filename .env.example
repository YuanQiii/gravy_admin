# NODE
NODE_ENV=development

# SERVER
PORT=3000

# DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/gvray_admin"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gvray_admin

# JWT
JWT_SECRET=your-super-secret-key
JWT_ACCESS_TOKEN_EXPIRES_IN=2h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# LOGGING
LOG_LEVEL=info
# 追加进 pino redact.paths 的额外敏感字段（逗号分隔），仅对 stdout 日志生效
LOG_REDACT=
# 慢请求阈值（毫秒），访问日志超过该值才附带请求体
LOG_SLOW_MS=1000
# 请求关联 ID 头名，缺失时由应用生成 UUID
LOG_REQ_ID_HEADER=x-request-id

# OPERATION LOG
OPLOG_ENABLED=true
OPLOG_MASK_FIELDS=password,oldPassword,newPassword,token,authorization,secret,captcha

# SEED
SUPER_ADMIN_INITIAL_PASSWORD=123456

# TIMEZONE
APP_TZ_SUFFIX=+08:00

# CORS
ENABLE_CORS=true
CORS_ORIGINS="http://example.com,http://example.org"

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gvr
REDIS_DEFAULT_TTL=3600
