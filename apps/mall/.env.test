# NODE
NODE_ENV=test

# SERVER
PORT=3000

# DATABASE
# 默认 harness 使用内存 mock，无需真实数据库。
# 如需连接真实测试基础设施（pnpm test:harness:up 启动）：
# DATABASE_URL="postgresql://postgres:test@localhost:5433/gvray_admin_test"
DATABASE_URL="postgresql://postgres:test@localhost:5433/gvray_admin_test"

# REDIS
# 默认 harness 使用内存 mock，无需真实 Redis。
# 如需连接真实测试基础设施：REDIS_HOST=localhost REDIS_PORT=6380
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DB=1
#REDIS_KEY_PREFIX=gvr
#REDIS_DEFAULT_TTL=3600

# JWT
JWT_SECRET="test-jwt-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# LOGGING
LOG_LEVEL=error

# OPERATION LOG
OPLOG_ENABLED=false
#OPLOG_MASK_FIELDS=password,oldPassword,newPassword,token,authorization,secret,captcha

# SEED
#SUPER_ADMIN_INITIAL_PASSWORD=123456

# TIMEZONE
#APP_TZ_SUFFIX=+08:00

# CORS
ENABLE_CORS=true
CORS_ORIGINS=""
