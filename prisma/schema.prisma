// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  userId        String         @unique @default(uuid())
  email         String?        @unique
  username      String         @unique
  nickname      String // 昵称，必须
  phone         String?        @unique
  password      String
  avatar        String?
  gender        String?        @db.VarChar(16) // 性别：unknown-未知, male-男, female-女, other-其他
  description   String?        @db.Text // 用户描述
  status        String         @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用, pending: 审核中, banned: 封禁
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [departmentId])
  userSettings  UserSettings?
  userPositions UserPosition[]
  userRoles     UserRole[]

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID  
  updatedBy   User?   @relation("UserUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // 反向关联 - 作为创建者/更新者的记录
  createdUsers           User[]           @relation("UserCreatedBy")
  updatedUsers           User[]           @relation("UserUpdatedBy")
  createdRoles           Role[]           @relation("RoleCreatedBy")
  updatedRoles           Role[]           @relation("RoleUpdatedBy")
  createdRolePerms       RolePermission[] @relation("RolePermissionCreatedBy")
  createdPerms           Permission[]     @relation("PermissionCreatedBy")
  updatedPerms           Permission[]     @relation("PermissionUpdatedBy")
  createdMenus           Menu[]           @relation("MenuCreatedBy")
  updatedMenus           Menu[]           @relation("MenuUpdatedBy")
  createdDepartments     Department[]     @relation("DepartmentCreatedBy")
  updatedDepartments     Department[]     @relation("DepartmentUpdatedBy")
  createdPositions       Position[]       @relation("PositionCreatedBy")
  updatedPositions       Position[]       @relation("PositionUpdatedBy")
  createdUserPositions   UserPosition[]   @relation("UserPositionCreatedBy")
  createdUserRoles       UserRole[]       @relation("UserRoleCreatedBy")
  createdDictionaryTypes DictionaryType[] @relation("DictionaryTypeCreatedBy")
  updatedDictionaryTypes DictionaryType[] @relation("DictionaryTypeUpdatedBy")
  createdDictionaryItems DictionaryItem[] @relation("DictionaryItemCreatedBy")
  updatedDictionaryItems DictionaryItem[] @relation("DictionaryItemUpdatedBy")
  createdConfigs         Config[]         @relation("ConfigCreatedBy")
  updatedConfigs         Config[]         @relation("ConfigUpdatedBy")
  createdRoleDepartments RoleDepartment[] @relation("RoleDepartmentCreatedBy")
  updatedRoleDepartments RoleDepartment[] @relation("RoleDepartmentUpdatedBy")
  createdNotices         Notice[]         @relation("NoticeCreatedBy")
  updatedNotices         Notice[]         @relation("NoticeUpdatedBy")
  // 业务域反向关系（add-equipment-inquiry-customer-domains）
  createdEquipmentBrands EquipmentBrand[] @relation("EquipmentBrandCreatedBy")
  updatedEquipmentBrands EquipmentBrand[] @relation("EquipmentBrandUpdatedBy")
  createdEquipmentCatalogs EquipmentCatalog[] @relation("EquipmentCatalogCreatedBy")
  updatedEquipmentCatalogs EquipmentCatalog[] @relation("EquipmentCatalogUpdatedBy")
  createdFilterTypes     FilterType[]     @relation("FilterTypeCreatedBy")
  updatedFilterTypes     FilterType[]     @relation("FilterTypeUpdatedBy")
  createdFilters         Filter[]         @relation("FilterCreatedBy")
  updatedFilters         Filter[]         @relation("FilterUpdatedBy")
  createdEquipment       Equipment[]      @relation("EquipmentCreatedBy")
  updatedEquipment       Equipment[]      @relation("EquipmentUpdatedBy")
  createdInquiries       Inquiry[]        @relation("InquiryCreatedBy")
  updatedInquiries       Inquiry[]        @relation("InquiryUpdatedBy")
  createdInquiryLines    InquiryLine[]    @relation("InquiryLineCreatedBy")
  updatedInquiryLines    InquiryLine[]    @relation("InquiryLineUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserSettings {
  id       Int    @id @default(autoincrement())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  settings Json @default("{}") // 用户个人偏好设置（自由 key-value）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Role {
  id              Int              @id @default(autoincrement())
  roleId          String           @unique @default(uuid())
  roleKey         String           @unique
  name            String           @unique
  description     String?          @db.Text // 角色描述
  status          String           @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  dataScope       Int              @default(1) // 数据权限：1-仅本人, 2-本部门, 3-本部门及以下, 4-自定义, 5-全部
  sort            Int              @default(0) // 排序权重
  remark          String?          @db.Text // 备注信息
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleDepartments RoleDepartment[] // 角色-部门关联（一对多）

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("RoleCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("RoleUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("RolePermissionCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// 角色-部门关联表（一对多关系）
model RoleDepartment {
  id           Int        @id @default(autoincrement())
  roleId       String
  departmentId String
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("RoleDepartmentCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("RoleDepartmentUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, departmentId])
  @@map("role_departments")
}

model Permission {
  id              Int              @id @default(autoincrement())
  permissionId    String           @unique @default(uuid())
  name            String
  code            String           @unique // API 权限代码，如：system:user:list
  httpMethod      String? // HTTP 方法：GET, POST, PUT, PATCH, DELETE（扫描器写入，seed 阶段可为空）
  description     String?          @db.Text // 权限描述
  origin          PermissionOrigin @default(SYSTEM) // 来源：SYSTEM=系统扫描
  deletedAt       DateTime? // API 权限软删除时间，非空表示已删除
  mutable         Boolean          @default(true) // SYSTEM=false, 不允许人工改元数据
  rolePermissions RolePermission[]

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("PermissionCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("PermissionUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

enum PermissionOrigin {
  USER   // 用户手动创建
  SYSTEM // 系统自动扫描生成
}

model Menu {
  id             Int      @id @default(autoincrement())
  menuId         String   @unique @default(uuid())
  name           String
  type           MenuType
  permissionCode String? // 绑定权限码，如：system:user:list
  code           String?  @unique // 国际化键，如：system.management
  path           String?  @unique
  icon           String?
  hidden         Boolean  @default(false)
  sort           Int      @default(0)
  status         String   @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  parentMenuId   String?
  parent         Menu?    @relation("MenuHierarchy", fields: [parentMenuId], references: [menuId], onDelete: Restrict, onUpdate: Restrict)
  children       Menu[]   @relation("MenuHierarchy")

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("MenuCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("MenuUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menus")
}

enum MenuType {
  CATALOG // 目录
  MENU    // 菜单
}

model Department {
  id              Int              @id @default(autoincrement())
  departmentId    String           @unique @default(uuid())
  name            String           @unique
  description     String?          @db.Text // 部门描述
  parentId        String?
  manager         String?
  phone           String?
  email           String?
  status          String           @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort            Int              @default(0)
  remark          String?          @db.Text // 备注信息
  parent          Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [departmentId], onDelete: Restrict, onUpdate: Restrict)
  children        Department[]     @relation("DepartmentHierarchy")
  users           User[] // 部门下的用户
  roleDepartments RoleDepartment[] // 角色-部门关联

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("DepartmentCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("DepartmentUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Position {
  id            Int            @id @default(autoincrement())
  positionId    String         @unique @default(uuid())
  name          String         @unique
  code          String         @unique
  description   String?        @db.Text // 岗位描述
  status        String         @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort          Int            @default(0)
  remark        String?        @db.Text // 备注信息
  userPositions UserPosition[]

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("PositionCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("PositionUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("positions")
}

model UserPosition {
  id         Int      @id @default(autoincrement())
  userId     String
  positionId String
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [positionId], onDelete: Cascade)

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("UserPositionCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, positionId])
  @@map("user_positions")
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("UserRoleCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@map("user_roles")
}

model DictionaryType {
  id          Int              @id @default(autoincrement())
  typeId      String           @unique @default(uuid())
  code        String           @unique // 字典类型编码
  name        String           @unique // 字典类型名称
  description String?          @db.Text // 字典类型描述
  status      String           @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort        Int              @default(0) // 排序权重
  remark      String?          @db.Text // 备注信息
  items       DictionaryItem[] // 字典项列表

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("DictionaryTypeCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("DictionaryTypeUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dictionary_types")
}

model DictionaryItem {
  id          Int            @id @default(autoincrement())
  itemId      String         @unique @default(uuid())
  typeCode    String // 字典类型编码
  type        DictionaryType @relation(fields: [typeCode], references: [code], onDelete: Cascade)
  value       String // 字典项值
  label       String // 显示标签
  description String?        @db.Text // 字典项描述
  status      String         @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort        Int            @default(0) // 排序权重
  remark      String?        @db.Text // 备注信息

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("DictionaryItemCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("DictionaryItemUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dictionary_items")
}

model Config {
  id          Int     @id @default(autoincrement())
  configId    String  @unique @default(uuid())
  key         String  @unique // 配置键
  value       String  @db.Text // 配置值
  name        String // 配置名称
  description String? @db.Text // 配置描述
  type        String  @default("string") // 配置类型: string, number, boolean, json
  group       String  @default("system") // 配置分组
  status      String  @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort        Int     @default(0) // 排序权重
  isPublic    Boolean @default(false) // 是否对前端公开
  remark      String? @db.Text // 备注信息

  // 审计字段
  createdById String? // 创建者ID
  createdBy   User?   @relation("ConfigCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String? // 更新者ID
  updatedBy   User?   @relation("ConfigUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configs")
}

model LoginLog {
  id         Int     @id @default(autoincrement())
  account    String // 登录用户名/邮箱/手机号
  ipAddress  String // 登录IP地址
  userAgent  String? // 用户代理信息
  result     String         @db.VarChar(16) // 登录结果：success-成功, failure-失败
  loginType  String  @default("username") // 登录类型：username(用户名), email(邮箱), phone(手机号), wechat(微信), qq(QQ), alipay(支付宝), github(GitHub), google(Google)
  failReason String? // 失败原因
  location   String? // 登录地点（可选，基于IP解析）
  device     String? // 设备信息
  browser    String? // 浏览器信息
  os         String? // 操作系统信息

  createdAt DateTime @default(now())

  @@map("login_logs")
}

model RefreshToken {
  id           Int      @id @default(autoincrement())
  tokenId      String   @unique @default(uuid())
  userId       String
  token        String   @unique @db.VarChar(500)
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OperationLog {
  id Int @id @default(autoincrement())

  // 用户信息
  userId   String?
  username String?
  nickname String?

  // 业务信息
  module   String?
  action   String?
  resource String?

  // 请求上下文
  method    String
  path      String
  query     Json?
  body      Json?
  ipAddress String?
  userAgent String?

  // 结果
  result    String         @db.VarChar(16) // success 成功, failure 失败
  message   String?
  latencyMs Int

  // 观测关联：同一请求的关联 ID（经 logging module 写入，可空）
  requestId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([result])
  @@index([requestId])
  @@map("operation_logs")
}

model Notice {
  id          Int     @id @default(autoincrement())
  noticeId    String  @unique @default(uuid())
  title       String
  content     String  @db.Text
  type        String  @default("notice") @db.VarChar(16) // notice: 通知, announcement: 通告
  status      String  @default("enabled") @db.VarChar(16) // disabled: 禁用, enabled: 启用
  sort        Int     @default(0)

  // 用户已读关联
  userReads UserNoticeRead[]

  // 审计字段
  createdById String?
  createdBy   User?   @relation("NoticeCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("NoticeUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}

model UserNoticeRead {
  id       Int      @id @default(autoincrement())
  userId   String
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [noticeId], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([userId, noticeId])
  @@map("user_notice_reads")
}

// ===== 业务域：设备/滤清器/询价/客户（add-equipment-inquiry-customer-domains）=====

/// 设备品牌（字典）
model EquipmentBrand {
  id        Int       @id @default(autoincrement())
  brandId   String    @unique @default(uuid())
  name      String    @unique
  slug      String?   @unique
  sortOrder Int       @default(0)
  status    String    @default("enabled") @db.VarChar(16)
  isHot     Boolean   @default(false) // 是否热门品牌
  hotOrder  Int?      // 热门排序（可空，未设则按生效设备数/入库时间兜底）
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("EquipmentBrandCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("EquipmentBrandUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  equipment Equipment[]

  @@index([deletedAt])
  @@map("equipment_brands")
}

/// 设备目录（字典）
model EquipmentCatalog {
  id          Int       @id @default(autoincrement())
  catalogId   String    @unique @default(uuid())
  name        String    @unique
  code        String?   @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  status      String    @default("enabled") @db.VarChar(16)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("EquipmentCatalogCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("EquipmentCatalogUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  equipment Equipment[]

  @@index([deletedAt])
  @@map("equipment_catalogs")
}

/// 滤清器类型（字典）
model FilterType {
  id          Int       @id @default(autoincrement())
  filterTypeId String   @unique @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  status      String    @default("enabled") @db.VarChar(16)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("FilterTypeCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("FilterTypeUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([deletedAt])
  @@map("filter_types")
}

/// 滤清器
model Filter {
  id           Int       @id @default(autoincrement())
  filterId     String    @unique @default(uuid())
  model        String    @unique
  typeName     String
  gencode      String?   @unique
  volume       Decimal?  @db.Decimal(10, 3)
  weight       Decimal?  @db.Decimal(10, 3)
  dimensionD1  Decimal?  @db.Decimal(10, 2)
  dimensionD2  Decimal?  @db.Decimal(10, 2)
  dimensionD3  Decimal?  @db.Decimal(10, 2)
  dimensionD7  String?
  dimensionH1  Decimal?  @db.Decimal(10, 2)
  dimensionH2  Decimal?  @db.Decimal(10, 2)
  dimensionH3  Decimal?  @db.Decimal(10, 2)
  dimensionD8  String?
  annb         String?
  bynb         String?
  photoUuid    String?
  drawingUuid  String?
  compatibility Json    @default("{}")
  sortOrder    Int       @default(0)
  status       String    @default("enabled") @db.VarChar(16)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("FilterCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("FilterUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  equipmentFilters EquipmentFilter[]
  inquiryLines     InquiryLine[]
  customerFavorites CustomerFavorite[]
  customerHistory  CustomerHistory[]

  @@index([deletedAt])
  @@index([typeName])
  @@map("filters")
}

/// 设备档案
model Equipment {
  id                  Int       @id @default(autoincrement())
  equipmentId         String    @unique @default(uuid())
  brandId             String?
  brand               EquipmentBrand? @relation(fields: [brandId], references: [brandId], onDelete: Restrict, onUpdate: Restrict)
  brandName           String
  model               String
  productionDateStart DateTime?
  productionDateEnd   DateTime?
  engineBrand         String?
  engineType          String?
  power               Decimal?  @db.Decimal(10, 2)
  engineEnergy        String?   @db.VarChar(32)
  catalogId           String?
  catalog             EquipmentCatalog? @relation(fields: [catalogId], references: [catalogId], onDelete: Restrict, onUpdate: Restrict)
  catalogName         String
  sortOrder           Int       @default(0)
  status              String    @default("enabled") @db.VarChar(16)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("EquipmentCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("EquipmentUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  equipmentFilters EquipmentFilter[]

  @@unique([brandName, model])
  @@index([deletedAt])
  @@index([brandId])
  @@index([catalogId])
  @@map("equipment")
}

/// 设备-滤清器多对多关联（事件型，无 updatedAt）
model EquipmentFilter {
  id          Int      @id @default(autoincrement())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade, onUpdate: Restrict)
  filterId    String
  filter      Filter    @relation(fields: [filterId], references: [filterId], onDelete: Cascade, onUpdate: Restrict)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([equipmentId, filterId])
  @@index([deletedAt])
  @@index([filterId])
  @@map("equipment_filters")
}

// ===== 询价单域 =====

/// 询价单
model Inquiry {
  id               Int       @id @default(autoincrement())
  inquiryId        String    @unique @default(uuid())
  inquiryNo        String    @unique
  title            String
  description      String?   @db.Text
  status           String    @default("draft") @db.VarChar(16)
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  totalAmount      Decimal?  @db.Decimal(12, 2)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Restrict)
  createdById      String?
  createdBy        User?     @relation("InquiryCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById      String?
  updatedBy        User?     @relation("InquiryUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  shippingAddressId String?
  shippingAddress  CustomerAddress? @relation(fields: [shippingAddressId], references: [addressId], onDelete: SetNull, onUpdate: Restrict)

  // ===== 收货地址快照（创建时点冻结，不随 CustomerAddress 修改/删除漂移）=====
  // 为什么冗余：shippingAddressId 是**引用**不是快照；地址硬删时外键 ON DELETE SET NULL
  // 会静默清空引用 → 已提交/已报价询价单的收货信息永久丢失且无迹可查。
  // 快照是展示与履约的真值，shippingAddressId 降级为溯源引用（可为 null）。
  // 与 InquiryLine 对 Filter 的快照、Inquiry.customerName/Email/Phone 联系人快照同范式。
  shippingReceiver      String?
  shippingPhone         String?
  shippingProvince      String?
  shippingCity          String?
  shippingDistrict      String?
  shippingDetailAddress String?
  shippingZipCode       String?

  submittedAt      DateTime?
  quotedAt         DateTime?
  expiresAt        DateTime?
  cancelledAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inquiryLines InquiryLine[]

  @@index([deletedAt])
  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@map("inquiries")
}

/// 询价单明细
model InquiryLine {
  id           Int       @id @default(autoincrement())
  inquiryLineId String   @unique @default(uuid())
  inquiryId    String
  inquiry      Inquiry   @relation(fields: [inquiryId], references: [inquiryId], onDelete: Cascade, onUpdate: Restrict)
  filterId     String?
  filter       Filter?   @relation(fields: [filterId], references: [filterId], onDelete: SetNull, onUpdate: Restrict)
  productName  String
  model        String?
  typeName     String?
  quantity     Int       @default(1)
  unitPrice    Decimal?  @db.Decimal(12, 2)
  subtotal     Decimal?  @db.Decimal(12, 2)
  remarks      String?   @db.Text
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 审计字段
  createdById String?
  createdBy   User?   @relation("InquiryLineCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  updatedById String?
  updatedBy   User?   @relation("InquiryLineUpdatedBy", fields: [updatedById], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([deletedAt])
  @@index([inquiryId])
  @@index([filterId])
  @@map("inquiry_lines")
}

// ===== 客户域 =====

/// B2C 客户（独立于后台 User）
model Customer {
  id         Int       @id @default(autoincrement())
  customerId String    @unique @default(uuid())
  username   String    @unique
  password   String
  email      String?   @unique
  phoneNumber String?  @unique
  nickName   String
  avatar     String?
  status     String    @default("enabled") @db.VarChar(16)
  openid     String?   @unique
  unionid    String?   @unique
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  addresses  CustomerAddress[]
  favorites  CustomerFavorite[]
  history    CustomerHistory[]
  inquiries  Inquiry[]

  @@index([deletedAt])
  @@index([status])
  @@map("customers")
}

/// 客户收货地址
model CustomerAddress {
  id           Int       @id @default(autoincrement())
  addressId    String    @unique @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: Restrict)
  receiver     String
  phone        String
  province     String
  city         String
  district     String?
  detailAddress String
  zipCode      String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 删除语义：**有意硬删**（DeleteStrategy.Hard，unify-soft-delete-mechanics）。
  // 不设 deletedAt——删除语义唯一入口是 CustomerAddressDeletion module，
  // 防止死列回潮。
  inquiries Inquiry[]

  @@index([customerId])
  @@index([isDefault])
  @@map("customer_addresses")
}

/// 客户收藏（事件型，无 updatedAt）
model CustomerFavorite {
  id         Int      @id @default(autoincrement())
  favoriteId String   @unique @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: Restrict)
  filterId   String
  filter     Filter   @relation(fields: [filterId], references: [filterId], onDelete: Cascade, onUpdate: Restrict)
  createdAt  DateTime @default(now())

  @@unique([customerId, filterId])
  @@index([filterId])
  @@map("customer_favorites")
}

/// 客户浏览历史（事件型，无 updatedAt，upsert 语义）
model CustomerHistory {
  id         Int      @id @default(autoincrement())
  historyId  String   @unique @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: Restrict)
  filterId   String
  filter     Filter   @relation(fields: [filterId], references: [filterId], onDelete: Cascade, onUpdate: Restrict)
  visitedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([customerId, filterId])
  @@index([filterId])
  @@index([visitedAt])
  @@index([customerId, visitedAt])
  @@map("customer_history")
}
